<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEvento.Views.VerTicketDoEvento"
             Title="VerTicketDoEvento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Lavanda}" >
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand">
        <Label 
            Text="Custo por participante!"
            FontFamily="Sora-ExtraLight"
            FontSize="40"
            TextColor="{StaticResource Gray900}"
            HorizontalOptions="Center" />
   
    
    <Frame Margin="10"
           BackgroundColor="{StaticResource Gray500}" >
        <HorizontalStackLayout>
            <Label 
                    Text="R$ 50,00 Por Pessoa"
                    FontFamily="Sora-ExtraLight"
                    FontSize="30" />
        </HorizontalStackLayout>
    </Frame>


    <Frame Margin="10" 
           BackgroundColor="{StaticResource Gray500}">
        <Grid RowDefinitions="Auto, Auto"
              ColumnDefinitions="*, *, 2*">
            <Label Grid.Row="0" Grid.Column="0" Text="Inicio Do Evento:" />
            <Label Grid.Row="0" Grid.Column="1" Text="Fim Do Evento:" />
            <Label Grid.Row="0" Grid.Column="2" Text="Numero De Participantes:" />
                                                
            <Label Grid.Row="1" Grid.Column="0" Text="1/10/2023" />
            <Label Grid.Row="1" Grid.Column="1" Text="1/11/2023" />
            <Label Grid.Row="1" Grid.Column="2" Text="300" />
        </Grid>
    </Frame>

        <Button 
            Margin="10"
            Padding="10"
            Text="Ver Resumo" Clicked="Button_Clicked"></Button>

        <Button
            Margin="10"
            Padding="10"
            Text="Voltar" Clicked="Button_Clicked_1"></Button>
    </VerticalStackLayout>
    
</ContentPage>